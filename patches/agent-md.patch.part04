+        AgentMdService::set_target_mode("codex", true).expect("enable");
+        AgentMdService::set_target_mode("codex", false).expect("disable");
+
+        assert_eq!(fs::read_to_string(&codex_path).unwrap(), "codex local");
+        let refreshed = AgentMdService::get_state().expect("refreshed");
+        let codex = refreshed.targets.iter().find(|t| t.id == "codex").unwrap();
+        assert!(!codex.use_global);
+    }
+
+    #[test]
+    #[serial]
+    fn changing_global_updates_enabled_targets_only() {
+        let temp = tempfile::tempdir().expect("tempdir");
+        let _guard = TestHomeGuard::set(temp.path());
+
+        let state = AgentMdService::get_state().expect("state");
+        let claude_path = target_path(&state, "claude");
+        let gemini_path = target_path(&state, "gemini");
+        for path in [&claude_path, &gemini_path] {
+            fs::create_dir_all(path.parent().expect("parent")).expect("mkdir");
+        }
+        fs::write(&claude_path, "claude local").unwrap();
+        fs::write(&gemini_path, "gemini local").unwrap();
+
+        AgentMdService::set_global_content("shared one").unwrap();
+        AgentMdService::set_target_mode("claude", true).unwrap();
+        AgentMdService::set_global_content("shared two").unwrap();
+
+        assert_eq!(fs::read_to_string(&claude_path).unwrap(), "shared two");
+        assert_eq!(fs::read_to_string(&gemini_path).unwrap(), "gemini local");
+    }
+
+    #[test]
+    #[serial]
+    fn local_edit_is_rejected_while_target_uses_global() {
+        let temp = tempfile::tempdir().expect("tempdir");
+        let _guard = TestHomeGuard::set(temp.path());
+
+        AgentMdService::set_global_content("shared").unwrap();
+        AgentMdService::set_target_mode("opencode", true).unwrap();
+        let error = AgentMdService::set_target_content("opencode", "local")
+            .expect_err("editing should fail");
+
+        assert!(error.to_string().to_lowercase().contains("global"));
+    }
+
+    #[test]
+    #[serial]
+    fn fresh_state_imports_existing_live_content_as_initial_local_draft() {
+        let temp = tempfile::tempdir().expect("tempdir");
+        let _guard = TestHomeGuard::set(temp.path());
+
+        let live_path = temp.path().join(".gemini").join("GEMINI.md");
+        fs::create_dir_all(live_path.parent().unwrap()).unwrap();
+        fs::write(&live_path, "existing gemini").unwrap();
+
+        let state = AgentMdService::get_state().expect("state");
+        let gemini = state.targets.iter().find(|t| t.id == "gemini").unwrap();
+
+        assert!(!gemini.use_global);
+        assert_eq!(gemini.local_content, "existing gemini");
+        assert_eq!(fs::read_to_string(&live_path).unwrap(), "existing gemini");
+    }
+}
