+++ b/src/components/agents/AgentMdEditorDialog.tsx
@@ -0,0 +1,86 @@
+import { useEffect, useState } from "react";
+import { useTranslation } from "react-i18next";
+import { Loader2 } from "lucide-react";
+import MarkdownEditor from "@/components/MarkdownEditor";
+import { useDarkMode } from "@/hooks/useDarkMode";
+import { Button } from "@/components/ui/button";
+import {
+  Dialog,
+  DialogContent,
+  DialogDescription,
+  DialogFooter,
+  DialogHeader,
+  DialogTitle,
+} from "@/components/ui/dialog";
+
+interface AgentMdEditorDialogProps {
+  open: boolean;
+  title: string;
+  description?: string;
+  path: string;
+  value: string;
+  saving?: boolean;
+  onOpenChange: (open: boolean) => void;
+  onSave: (value: string) => Promise<boolean | void>;
+}
+
+export function AgentMdEditorDialog({
+  open,
+  title,
+  description,
+  path,
+  value,
+  saving = false,
+  onOpenChange,
+  onSave,
+}: AgentMdEditorDialogProps) {
+  const { t } = useTranslation();
+  const darkMode = useDarkMode();
+  const [draft, setDraft] = useState(value);
+
+  useEffect(() => {
+    if (open) setDraft(value);
+  }, [open, value]);
+
+  const dirty = draft !== value;
+
+  const handleSave = async () => {
+    const result = await onSave(draft);
+    if (result !== false) onOpenChange(false);
+  };
+
+  return (
+    <Dialog open={open} onOpenChange={(next) => !saving && onOpenChange(next)}>
+      <DialogContent className="max-w-4xl">
+        <DialogHeader>
+          <DialogTitle>{title}</DialogTitle>
+          <DialogDescription className="space-y-1">
+            {description ? <span className="block">{description}</span> : null}
+            <span className="block break-all font-mono text-xs">{path}</span>
+          </DialogDescription>
+        </DialogHeader>
+        <div className="min-h-0 flex-1 px-6 py-5">
+          <MarkdownEditor
+            value={draft}
+            onChange={setDraft}
+            darkMode={darkMode}
+            minHeight="420px"
+            maxHeight="60vh"
+            placeholder={t("agents.editorPlaceholder", {
+              defaultValue: "Write agent instructions in Markdown...",
+            })}
+          />
+        </div>
+        <DialogFooter>
+          <Button variant="outline" disabled={saving} onClick={() => onOpenChange(false)}>
+            {t("common.cancel", { defaultValue: "Cancel" })}
+          </Button>
+          <Button disabled={saving || !dirty} onClick={() => void handleSave()}>
+            {saving ? <Loader2 className="mr-2 h-4 w-4 animate-spin" /> : null}
+            {t("common.save", { defaultValue: "Save" })}
+          </Button>
+        </DialogFooter>
+      </DialogContent>
+    </Dialog>
+  );
+}
