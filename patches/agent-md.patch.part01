diff --git a/src-tauri/src/commands/agent_md.rs b/src-tauri/src/commands/agent_md.rs
new file mode 100644
index 0000000..8956c07
--- /dev/null
+++ b/src-tauri/src/commands/agent_md.rs
@@ -0,0 +1,21 @@
+use crate::services::{AgentMdService, AgentMdState};
+
+#[tauri::command]
+pub async fn get_agent_md_state() -> Result<AgentMdState, String> {
+    AgentMdService::get_state().map_err(|error| error.to_string())
+}
+
+#[tauri::command]
+pub async fn set_agent_md_global_content(content: String) -> Result<(), String> {
+    AgentMdService::set_global_content(&content).map_err(|error| error.to_string())
+}
+
+#[tauri::command]
+pub async fn set_agent_md_target_mode(target_id: String, use_global: bool) -> Result<(), String> {
+    AgentMdService::set_target_mode(&target_id, use_global).map_err(|error| error.to_string())
+}
+
+#[tauri::command]
+pub async fn set_agent_md_target_content(target_id: String, content: String) -> Result<(), String> {
+    AgentMdService::set_target_content(&target_id, &content).map_err(|error| error.to_string())
+}
